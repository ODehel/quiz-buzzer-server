{
  "name": "quiz-buzzer-server",
  "version": "1.0.0",
  "description": "Hub Node.js pour communiquer entre l'application du maître du jeu et les buzzers ainsi que pour gérer le workflow du quiz",
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "generate-env": "node --experimental-strip-types scripts/generate-env.ts",
    "test": "node --experimental-strip-types --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.0",
    "jsonwebtoken": "^9.0.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.21",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.15",
    "@types/ws": "^8.18.1",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
