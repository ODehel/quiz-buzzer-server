{
  "name": "quiz-buzzer-server",
  "version": "1.0.0",
  "description": "Hub Node.js pour communiquer entre l'application du maître du jeu et les buzzers ainsi que pour gérer le workflow du quiz",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node src/seed.js",
    "generate-env": "node scripts/generate-env.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.0.0",
    "busboy": "^1.6.0",
    "dotenv": "^16.4.0",
    "jsonwebtoken": "^9.0.0",
    "pino": "^10.3.1",
    "pino-roll": "^4.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0"
  }
}
